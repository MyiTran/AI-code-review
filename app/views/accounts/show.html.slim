.d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Account
    p.page-description
      | Manage your account and subscription.

.dashboard-card.mb-4
  .p-4.border-bottom
    .d-flex.align-items-center.gap-3
      span.settings-section-icon
        i.bi.bi-person

      div
        h2.card-title-custom Account information
        p.mb-0.mt-1.text-secondary.small
          | Your account information from GitHub.

  .p-4
    .d-flex.flex-column.flex-md-row.align-items-md-center.gap-4.mb-4
      - if @user.avatar_url.present?
        = image_tag @user.avatar_url, class: 'rounded-circle', width: 72, height: 72, alt: @user.display_name
      - else
        .rounded-circle.bg-light.d-flex.align-items-center.justify-content-center style="width: 72px; height: 72px;"
          span.fw-bold.fs-4
            = @user.initials

      div
        h3.fs-5.mb-1
          = @user.display_name.presence || 'GitHub user'

        - if @user.github_username.present?
          p.text-secondary.mb-0
            | @#{@user.github_username}

    .row.g-4
      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Name
          span.fw-semibold
            = @user.full_name.presence || 'Not provided'

      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Email
          span.fw-semibold
            = @user.email

      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 GitHub username
          span.fw-semibold
            = @user.github_username.presence || 'Not available'

.dashboard-card.mb-4
  .p-4.border-bottom
    .d-flex.align-items-center.gap-3
      span.settings-section-icon
        i.bi.bi-credit-card

      div
        h2.card-title-custom Subscription
        p.mb-0.mt-1.text-secondary.small
          | Manage your current plan.

  .p-4
    .row.g-4
      .col-12.col-lg-6
        .border.rounded-3.p-4.h-100
          .d-flex.justify-content-between.align-items-center.mb-3
            h3.fs-5.mb-0 Free

            - unless @user.pro?
              span.badge.badge-soft-success.rounded-pill Current plan

          h4.fs-3.fw-bold.mb-4
            | $0
            span.fs-6.fw-normal.text-secondary
              |  / month

          p.mb-2
            | 1 AI model — Gemini Flash Lite
          p.mb-2
            | 3 repositories
          p.mb-2
            | 30 pull requests / month
          p.mb-4
            | 60 AI reviews / month

          - if @user.pro?
            = button_to 'Switch to Free', account_path, method: :patch, params: { plan: 'free', user_id: @user.id }, class: 'btn btn-outline-primary w-100'
          - else
            button.btn.btn-light.w-100 type="button" disabled=true
              | Current plan

      .col-12.col-lg-6
        .border.rounded-3.p-4.h-100
          .d-flex.justify-content-between.align-items-center.mb-3
            h3.fs-5.mb-0 Pro

            - if @user.pro?
              span.badge.badge-soft-success.rounded-pill Current plan

          h4.fs-3.fw-bold.mb-4
            | $19
            span.fs-6.fw-normal.text-secondary
              |  / month

          p.mb-2
            | 2 AI models — Gemini Flash Lite + Gemini Flash
          p.mb-2
            | 50 repositories
          p.mb-2
            | 500 pull requests / month
          p.mb-4
            | 1,000 AI reviews / month

          - if @user.pro?
            button.btn.btn-light.w-100 type="button" disabled=true
              | Current plan
          - else
            = button_to 'Upgrade to Pro', account_path, method: :patch, params: { plan: 'pro', user_id: @user.id }, class: 'btn btn-primary w-100'

.dashboard-card
  .p-4.border-bottom
    .d-flex.align-items-center.gap-3
      span.settings-section-icon
        i.bi.bi-shield-check

      div
        h2.card-title-custom Sign-in information
        p.mb-0.mt-1.text-secondary.small
          | Information about your account activity.

  .p-4
    .row.g-4
      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Member since
          span.fw-semibold
            = l(@user.created_at, format: :long)

      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Last signed in
          span.fw-semibold
            - if @user.last_sign_in_at.present?
              = l(@user.last_sign_in_at, format: :long)
            - else
              | Not available

      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Sign-in count
          span.fw-semibold
            = @user.sign_in_count
