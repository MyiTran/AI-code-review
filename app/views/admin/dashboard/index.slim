.d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.gap-3.mb-4
  div
    .d-flex.align-items-center.gap-2.mb-1
      h1.page-title.mb-0 Admin Dashboard

      span.badge.admin-badge.rounded-pill
        i.bi.bi-shield-check.me-1
        | Admin

    p.page-description
      | Monitor platform usage, users, AI reviews and system health.

  .d-flex.flex-wrap.gap-2
    button.btn.btn-light type="button"
      i.bi.bi-download.me-2
      | Export report

    button.btn.btn-primary type="button"
      i.bi.bi-person-plus.me-2
      | Invite user

.row.g-4.mb-4
  - @admin[:stats].each do |stat|
    .col-12.col-sm-6.col-xl-3
      .dashboard-card.admin-stat-card
        .d-flex.align-items-start.justify-content-between.gap-3
          div
            p.admin-stat-label
              = stat[:label]

            p.admin-stat-value
              = number_with_delimiter(stat[:value])

            .d-flex.align-items-center.gap-2
              - if stat[:trend] == 'up'
                span.admin-stat-change.admin-stat-change-positive
                  i.bi.bi-arrow-up-right
                  = stat[:change]
              - else
                span.admin-stat-change.admin-stat-change-positive
                  i.bi.bi-arrow-down-right
                  = stat[:change]

              span.text-secondary.small
                | vs last month

          span class="admin-stat-icon admin-stat-icon-#{stat[:style]}"
            i class="bi #{stat[:icon]}"

.row.g-4.mb-4
  .col-12.col-xl-8
    .dashboard-card.h-100
      .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3.p-4.border-bottom
        div
          h2.card-title-custom AI review volume

          p.mb-0.mt-1.text-secondary.small
            | Monthly AI reviews across all accounts.

        select.form-select.admin-period-select
          option Last 6 months
          option Last 12 months
          option This year

      .p-4
        - maximum_reviews = @admin[:usage].pluck(:reviews).max

        .admin-chart
          - @admin[:usage].each do |item|
            - bar_height = (item[:reviews].to_f / maximum_reviews * 100).round

            .admin-chart-column
              .admin-chart-value
                = number_to_human(item[:reviews], precision: 2)

              .admin-chart-track
                .admin-chart-bar style="height: #{bar_height}%"

              .admin-chart-label
                = item[:month]

  .col-12.col-xl-4
    .dashboard-card.h-100
      .p-4.border-bottom
        .d-flex.align-items-center.justify-content-between
          div
            h2.card-title-custom System health

            p.mb-0.mt-1.text-secondary.small
              | Current platform status.

          span.system-status-dot

      .p-4
        .system-overall-status
          span.system-status-icon
            i.bi.bi-check-lg

          div
            p.mb-1.fw-bold
              = @admin[:system][:status]

            p.mb-0.text-secondary.small
              | All services are running normally.

        .admin-system-row
          span.text-secondary Uptime

          strong
            = @admin[:system][:uptime]

        .admin-system-row
          span.text-secondary Queue size

          strong
            = @admin[:system][:queue_size]

        .admin-system-row
          span.text-secondary Average review time

          strong
            = @admin[:system][:average_review_time]

        .admin-system-row.border-0.pb-0
          span.text-secondary Webhook success

          strong.text-success
            = @admin[:system][:webhook_success_rate]

.row.g-4.mb-4
  .col-12.col-xl-8
    .dashboard-card
      .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3.p-4.border-bottom
        div
          h2.card-title-custom Recent users

          p.mb-0.mt-1.text-secondary.small
            | Recently registered and active accounts.

        .d-flex.align-items-center.gap-2
          .input-group.input-group-sm.admin-table-search
            span.input-group-text.bg-white.border-end-0
              i.bi.bi-search.text-secondary

            input.form-control.border-start-0.ps-0 type="search" placeholder="Search users"

          = link_to 'View all',
            admin_users_path,
            class: 'btn btn-light btn-sm'

      .table-responsive
        table.table.mb-0
          thead
            tr
              th User
              th Plan
              th Repositories
              th Reviews
              th Status
              th Joined
              th

          tbody
            - @admin[:users].each do |user|
              tr
                td
                  .d-flex.align-items-center.gap-3
                    span.admin-user-avatar
                      = user[:initials]

                    div
                      = link_to repositories_path(user_id: user[:id]),
                            class: 'text-decoration-none' do
                        p.mb-1.fw-semibold.text-dark
                            = user[:name]

                        p.mb-0.text-secondary.small
                            = user[:email]

                td
                  - if user[:plan] == 'Team'
                    span.badge.admin-plan-team.rounded-pill
                      = user[:plan]
                  - elsif user[:plan] == 'Pro'
                    span.badge.admin-plan-pro.rounded-pill
                      = user[:plan]
                  - else
                    span.badge.bg-light.text-secondary.rounded-pill
                      = user[:plan]

                td
                  = user[:repositories]

                td
                  = number_with_delimiter(user[:reviews])

                td
                  - if user[:status] == 'Active'
                    span.badge.badge-soft-success.rounded-pill.px-3.py-2
                      span.status-mini-dot.me-1
                      | Active
                  - else
                    span.badge.badge-soft-danger.rounded-pill.px-3.py-2
                      | Suspended

                td.text-secondary.small
                  = user[:joined_at]

                td.text-end
                  button.btn.btn-sm.btn-light type="button"
                    i.bi.bi-three-dots

  .col-12.col-xl-4
    .dashboard-card.h-100
      .p-4.border-bottom
        h2.card-title-custom Recent activity

        p.mb-0.mt-1.text-secondary.small
          | Latest platform-level events.

      .admin-activity-list
        - @admin[:activities].each do |activity|
          .admin-activity-item
            span class="admin-activity-icon admin-activity-icon-#{activity[:style]}"
              i class="bi #{activity[:icon]}"

            div
              p.admin-activity-title
                = activity[:title]

              p.admin-activity-description
                = activity[:description]

              p.admin-activity-time
                = activity[:time]

.dashboard-card
  .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3.p-4.border-bottom
    div
      h2.card-title-custom Recent AI reviews

      p.mb-0.mt-1.text-secondary.small
        | Latest AI jobs processed across the platform.

  .table-responsive
    table.table.mb-0
      thead
        tr
          th Pull request
          th Repository
          th User
          th AI model
          th Duration
          th Status
          th Created
          th

      tbody
        - @admin[:recent_reviews].each do |review|
          tr
            td
              = link_to review[:pull_request],
                  review_path(review[:id]),
                  class: 'fw-semibold text-dark text-decoration-none'

            td
              span.repository-small-link
                i.bi.bi-github.me-2
                = review[:repository]

            td
              = review[:user]

            td
              span.ai-model-badge
                i.bi.bi-stars
                = review[:model]

            td
              = review[:duration]

            td
              - if review[:status] == 'Completed'
                span.badge.badge-soft-success.rounded-pill.px-3.py-2
                  i.bi.bi-check-circle.me-1
                  | Completed
              - else
                span.badge.badge-soft-warning.rounded-pill.px-3.py-2
                  i.bi.bi-arrow-repeat.me-1
                  | Processing

            td.text-secondary.small
              = review[:created_at]

            td.text-end
              = link_to review_path(review[:id]), class: 'btn btn-sm btn-light' do
                i.bi.bi-chevron-right
                