.d-flex.align-items-center.justify-content-between.mb-4
  div
    h1.page-title Users
    p.page-description.mb-0
      | View and manage user subscriptions

.dashboard-card.mb-4
  .p-4
    = form_with url: admin_users_path, method: :get, data: { turbo: false } do |form|
      .row.g-3.align-items-end
        .col-md-10
          = form.text_field :q,
            value: params[:q],
            placeholder: 'Search by name, email or GitHub username...',
            class: 'form-control'

        .col-md-1
          = form.submit 'Search', class: 'btn btn-primary w-100'
        
        .col-md-1
          = link_to 'Clear', admin_users_path, class: 'btn btn-secondary w-100'

.dashboard-card
  .table-responsive
    table.table.mb-0
      thead
        tr
          th User
          th Email
          th.text-center Plan
          th Repositories
          th Joined
          th

      tbody
        - @users.each do |user|
          tr
            td
              span.fw-semibold
                = user.display_name.presence || 'Unknown'

            td
              = user.email

            td.text-center
              span.badge class=(user.plan == 'pro' ? 'admin-plan-pro' : 'bg-secondary')
                = user.plan.titleize

            td
              = @repository_counts[user.id].to_i

            td
              = user.created_at.strftime('%d/%m/%Y')

            td.text-end
              = link_to 'View', admin_user_path(user), class: 'btn btn-sm btn-outline-primary'

  - if @pagy.pages > 1
    .d-flex.justify-content-center.p-4
      == @pagy.series_nav
