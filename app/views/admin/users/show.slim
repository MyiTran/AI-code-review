.d-flex.align-items-center.justify-content-between.mb-4
  div
    h1.page-title
      = @user.display_name.presence || @user.email

    p.page-description.mb-0
      = @user.email

  = link_to 'Back', admin_users_path, class: 'btn btn-light'

.dashboard-card.mb-4
  .p-4
    h2.card-title-custom.mb-4 User information

    .row.g-4
      .col-md-4
        p.text-secondary.small.mb-1 Email
        p.fw-semibold.mb-0
          = @user.email

      .col-md-4
        p.text-secondary.small.mb-1 Current plan
        p.fw-semibold.mb-0
          = @user.plan.titleize

      .col-md-4
        p.text-secondary.small.mb-1 Joined
        p.fw-semibold.mb-0
          = @user.created_at.strftime('%d/%m/%Y')

.dashboard-card.mb-4
  .p-4
    h2.card-title-custom.mb-4 Subscription

    = form_with model: [:admin, @user], method: :patch do |form|
      .row.g-3.align-items-end
        .col-md-4
          = form.label :plan, 'Plan', class: 'form-label'
          = form.select :plan, options_for_select([['Free', 'free'], ['Pro', 'pro']], @user.plan), {}, class: 'form-select'

        .col-md-auto
          = form.submit 'Update plan', class: 'btn btn-primary'

.dashboard-card
  .p-4.border-bottom
    h2.card-title-custom.mb-0 Repositories

  .table-responsive
    table.table.mb-0
      thead
        tr
          th Repository
          th Status
          th AI model
          th

      tbody
        - @repositories.each do |repository|
          tr
            td
              span.fw-semibold
                = repository.name

            td
              - if repository.connected?
                span.badge.badge-soft-success.rounded-pill
                  | Connected
              - else
                span.badge.bg-light.text-secondary.rounded-pill
                  | Disconnected

            td
              = repository.ai_model&.name || 'Default'

            td.text-end
              = link_to 'View', admin_user_repository_path(@user, repository), class: 'btn btn-sm btn-light'
