= turbo_stream_from current_user, :dashboard
.d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Dashboard

    p.page-description
      | Monitor repositories, pull requests and AI review activity.

.row.g-4.mb-4
  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-github

      .stat-value.mb-2
        = @repository_count

      .stat-label Repositories

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-git

      .stat-value.mb-2
        = @pull_request_count

      .stat-label Pull Requests

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-success.mb-4
        i.bi.bi-stars

      .stat-value.mb-2
        = @review_count

      .stat-label AI Reviews

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-danger.mb-4
        i.bi.bi-bug

      .stat-value.mb-2
        = @issues_found_count

      .stat-label Issues Found

.row.g-4.mb-4
  .col-12
    .dashboard-card
      .d-flex.align-items-center.justify-content-between.p-4.border-bottom
        div
          h2.card-title-custom Recent repositories

          p.mb-0.mt-1.text-secondary.small
            | Recently updated repositories

        = link_to 'View all', repositories_path, class: 'btn btn-sm btn-light'

      - if @repositories.any?
        .table-responsive
          table.table.mb-0
            thead
              tr
                th Repository
                th Language
                th AI model
                th Connection
                th Last activity
                th

            tbody
              - @repositories.each do |repository|
                tr
                  td
                    .d-flex.align-items-center.gap-3
                      span.repository-icon
                        i.bi.bi-github

                      .fw-semibold
                        = repository.name

                  td
                    span.small
                      = repository.language.presence || 'Unknown'

                  td
                    span.ai-model-badge
                      i.bi.bi-stars
                      = repository.ai_model&.name || 'Default model'

                  td
                    - if repository.connected?
                      span.badge.badge-soft-success.rounded-pill.px-3.py-2
                        | Connected
                    - else
                      span.badge.bg-light.text-secondary.rounded-pill.px-3.py-2
                        | Disconnected

                  td.text-secondary.small
                    = l(repository.updated_at, format: :short)

                  td.text-end
                    = link_to repository_path(repository), class: 'btn btn-sm btn-light' do
                      i.bi.bi-chevron-right
      - else
        .text-center.p-5
          h3.fs-5 No repositories found

          p.text-secondary.mb-0
            | Connect a repository to get started.

.row.g-4
  .col-12
    .dashboard-card
      .d-flex.align-items-center.justify-content-between.p-4.border-bottom
        div
          h2.card-title-custom Recent AI reviews

          p.mb-0.mt-1.text-secondary.small
            | Latest pull requests analyzed by AI

        = link_to 'View all reviews', reviews_path, class: 'btn btn-light'

      - if @recent_reviews.any?
        .table-responsive
          table.table.mb-0
            thead
              tr
                th Pull request
                th Repository
                th AI model
                th Issues found
                th Status
                th Reviewed
                th

            tbody
              - @recent_reviews.each do |review|
                - pull_request = review.pull_request
                - repository = pull_request.repository

                tr
                  td
                    .fw-semibold
                      | ##{pull_request.number} #{pull_request.title}

                  td
                    .d-flex.align-items-center.gap-2
                      i.bi.bi-github
                      span
                        = repository.name

                  td
                    span.ai-model-badge
                      i.bi.bi-stars
                      = review.ai_model.name

                  td
                    - if review.issues_found_count.positive?
                      span.fw-semibold.text-danger
                        = review.issues_found_count
                    - else
                      span.text-success
                        | No issues

                  td
                    - if review.status == 'completed'
                      span.badge.badge-soft-success.rounded-pill.px-3.py-2
                        i.bi.bi-check-circle.me-1
                        | Completed
                    - elsif review.status == 'failed'
                      span.badge.badge-soft-danger.rounded-pill.px-3.py-2
                        i.bi.bi-x-circle.me-1
                        | Failed
                    - else
                      span.badge.badge-soft-warning.rounded-pill.px-3.py-2
                        i.bi.bi-arrow-repeat.me-1
                        | Processing

                  td.text-secondary.small
                    - if review.reviewed_at.present?
                      = l(review.reviewed_at, format: :short)
                    - else
                      | -

                  td.text-end
                    = link_to review_path(review), class: 'btn btn-sm btn-light' do
                      i.bi.bi-chevron-right
      - else
        .text-center.p-5
          h3.fs-5 No AI reviews yet

          p.text-secondary.mb-0
            | AI review activity will appear here.
