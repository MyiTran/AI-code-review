= turbo_stream_from current_user, :dashboard

.d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Dashboard

    p.page-description
      | Monitor repositories, pull requests and AI review activity.

.row.g-4.mb-4
  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-github

      .stat-value.mb-2
        | #{@dashboard.repository_count} / #{@dashboard.repository_limit}

      .stat-label.mb-2
        | Repositories

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-git

      .stat-value.mb-2
        | #{@dashboard.pull_request_count} / #{@dashboard.pull_request_limit}

      .stat-label.mb-2
        | Pull Requests

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-stars

      .stat-value.mb-2
        | #{@dashboard.monthly_review_count} / #{@dashboard.monthly_review_limit}

      .stat-label.mb-2
        | AI Reviews

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-bug

      .stat-value.mb-2
        = @dashboard.issues_found_count

      .stat-label.mb-2
        | Issues Found

.row.g-4.mb-4
  .col-12.col-xl-8
    .dashboard-card
      .d-flex.align-items-center.justify-content-between.p-4.border-bottom
        div
          h2.card-title-custom Recent repositories

          p.mb-0.mt-1.text-secondary.small
            | Repositories connected to AI Review

        = link_to 'View all', repositories_path, class: 'btn btn-sm btn-light'

      - if @dashboard.recent_repositories.any?
        .table-responsive
          table.table.mb-0
            thead
              tr
                th Repository
                th Language
                th AI model
                th Status
                th Last activity

            tbody
              - @dashboard.recent_repositories.each do |repository|
                tr
                  td
                    .d-flex.align-items-center.gap-3
                      span.repository-icon
                        i.bi.bi-github

                      .fw-semibold
                        = repository.name

                  td
                    span.small
                      = repository.language.presence || 'Unknown'

                  td
                    span.ai-model-badge
                      i.bi.bi-stars
                      = repository.ai_model&.name || 'Default model'

                  td
                    - if repository.connected?
                      span.badge.badge-soft-success.rounded-pill.px-3.py-2
                        | Connected
                    - else
                      span.badge.badge-soft-warning.rounded-pill.px-3.py-2
                        | Disconnected

                  td.text-secondary.small
                    = l(repository.updated_at, format: :short)
      - else
        .text-center.p-5
          p.text-secondary.mb-0
            | No repositories found.

  .col-12.col-xl-4
    .dashboard-card.p-4
      .d-flex.align-items-center.justify-content-between.mb-4
        div
          h2.card-title-custom Monthly usage

          p.mb-0.mt-1.text-secondary.small
            | #{@dashboard.plan_name} plan AI review allowance

        span.stat-icon.stat-icon-primary
          i.bi.bi-lightning-charge

      .text-center.py-3
        .display-5.fw-bold.mb-1
          = @dashboard.monthly_review_count

        p.text-secondary.mb-4
          | of #{@dashboard.monthly_review_limit} reviews used

      .progress.mb-3
        .progress-bar[
          role="progressbar"
          style="width: #{@dashboard.monthly_usage_percent}%"
          aria-valuenow=@dashboard.monthly_usage_percent
          aria-valuemin="0"
          aria-valuemax="100"
        ]

      .d-flex.justify-content-between.text-secondary.small.mb-4
        span
          | #{@dashboard.monthly_usage_percent}% used

        span
          | #{@dashboard.monthly_review_remaining} remaining

      .p-3.rounded-3.bg-light
        .d-flex.gap-3
          i.bi.bi-info-circle.text-primary

          div
            p.mb-1.fw-semibold.small
              | Current plan: #{@dashboard.plan_name}

            p.mb-0.text-secondary.small
              = current_user.pro? ? 'You are using the Pro plan.' : 'Upgrade your plan to increase your monthly AI review limit.'

      - unless current_user.pro?
        = link_to 'Upgrade plan', account_path, class: 'btn btn-outline-primary w-100 mt-4 rounded-3'

.row.g-4
  .col-12
    .dashboard-card
      .d-flex.align-items-center.justify-content-between.p-4.border-bottom
        div
          h2.card-title-custom Recent AI reviews

          p.mb-0.mt-1.text-secondary.small
            | Latest pull requests analyzed by AI

        = link_to 'View all reviews', reviews_path, class: 'btn btn-light'

      - if @dashboard.recent_reviews.any?
        .table-responsive
          table.table.mb-0
            thead
              tr
                th Pull request
                th Repository
                th AI model
                th Issues found
                th Status
                th Reviewed

            tbody
              - @dashboard.recent_reviews.each do |review|
                - pull_request = review.pull_request
                - repository = pull_request.repository

                tr
                  td
                    = link_to review_path(review), class: 'text-decoration-none text-dark fw-semibold' do
                      | ##{pull_request.number} #{pull_request.title}

                  td
                    .d-flex.align-items-center.gap-2
                      i.bi.bi-github
                      span
                        = repository.name

                  td
                    span.ai-model-badge
                      i.bi.bi-stars
                      = review.ai_model.name

                  td
                    - if review.issues_found_count.positive?
                      span.fw-semibold.text-danger
                        = review.issues_found_count
                    - else
                      span.text-success
                        | No issues

                  td
                    - if review.status == 'completed'
                      span.badge.badge-soft-success.rounded-pill.px-3.py-2
                        i.bi.bi-check-circle.me-1
                        | Completed
                    - elsif review.status == 'failed'
                      span.badge.badge-soft-danger.rounded-pill.px-3.py-2
                        i.bi.bi-x-circle.me-1
                        | Failed
                    - else
                      span.badge.badge-soft-warning.rounded-pill.px-3.py-2
                        i.bi.bi-arrow-repeat.me-1
                        | Processing

                  td.text-secondary.small
                    - if review.reviewed_at.present?
                      = l(review.reviewed_at, format: :short)
                    - else
                      | -
      - else
        .text-center.p-5
          p.text-secondary.mb-0
            | No AI reviews yet.
