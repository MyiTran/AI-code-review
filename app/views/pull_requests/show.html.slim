= turbo_stream_from @pull_request

= render 'shared/pull_request_details',
  pull_request: @pull_request,
  reviews: @reviews,
  back_path: repository_path(@pull_request.repository),
  review_path_for: ->(review) { review_path(review, repository_id: @pull_request.repository_id, pull_request_id: @pull_request.id) }
  