.d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Repositories

    p.page-description
      - if @selected_user.present?
        | Repositories connected by #{@selected_user[:name]}.
      - else
        | Connect repositories and configure automatic AI code review.

  button.btn.btn-primary.px-4.py-2.rounded-3 type="button"
    i.bi.bi-plus-lg.me-2
    | Connect repository

.dashboard-card.mb-4
  .p-4
    = form_with url: repositories_path,
        method: :get,
        local: true,
        class: 'row g-3 align-items-end' do |form|
      - if params[:user_id].present?
        = form.hidden_field :user_id, value: params[:user_id]

      .col-12.col-xl-4
        = form.label :query,
            'Search repositories',
            class: 'form-label small fw-semibold'

        .input-group
          span.input-group-text.bg-white.border-end-0
            i.bi.bi-search.text-secondary

          = form.search_field :query,
              value: params[:query],
              placeholder: 'Search by repository name...',
              class: 'form-control border-start-0 ps-0'

      .col-6.col-md-4.col-xl-2
        = form.label :connection_status,
            'Connection',
            class: 'form-label small fw-semibold'

        = form.select :connection_status,
            options_for_select(['Connected', 'Disconnected'], params[:connection_status]),
            { include_blank: 'All connections' },
            class: 'form-select'

      .col-6.col-md-4.col-xl-2
        = form.label :language,
            'Language',
            class: 'form-label small fw-semibold'

        = form.select :language,
            options_for_select(@languages, params[:language]),
            { include_blank: 'All languages' },
            class: 'form-select'

      .col-6.col-md-4.col-xl-2
        = form.label :ai_model,
            'AI model',
            class: 'form-label small fw-semibold'

        = form.select :ai_model,
            options_for_select(@models, params[:ai_model]),
            { include_blank: 'All models' },
            class: 'form-select'

      .col-6.col-md-4.col-xl-2
        .d-flex.gap-2
          = form.submit 'Apply',
              class: 'btn btn-primary flex-grow-1'

          = link_to repositories_path,
              class: 'btn btn-light',
              title: 'Clear filters' do
            i.bi.bi-arrow-counterclockwise

.dashboard-card
  .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-2.p-4.border-bottom
    div
      h2.card-title-custom Connected repositories

      p.mb-0.mt-1.text-secondary.small
        | #{@repositories.count} repositories found

    .d-flex.align-items-center.gap-2.text-secondary.small
      i.bi.bi-shield-check
      | GitHub App connected

  - if @repositories.any?
    .table-responsive
      table.table.mb-0.repository-table
        thead
          tr
            th Repository
            th Language
            th AI model
            th AI auto review
            th Connection
            th Last reviewed
            th

        tbody
          - @repositories.each do |repository|
            tr
              td
                = link_to repository_path(repository[:id], user_id: params[:user_id]),
                    class: 'repository-name-link' do
                  .d-flex.align-items-center.gap-3
                    span.repository-icon
                      i.bi.bi-github

                    div
                      p.mb-1.fw-semibold.text-dark
                        = repository[:name]

                      p.mb-0.text-secondary.small.repository-description
                        = repository[:description]

              td
                span.language-badge
                  span.language-dot
                  = repository[:language]

              td
                - if repository[:ai_model].present?
                  span.ai-model-badge
                    i.bi.bi-stars
                    = repository[:ai_model]
                - else
                  span.text-secondary.small
                    | Not selected

              td
                - status_class = repository[:auto_review_enabled] ? 'text-success' : 'text-secondary'
                - status_text = repository[:auto_review_enabled] ? 'On' : 'Off'
                - disconnected = repository[:connection_status] == 'Disconnected'

                .d-flex.align-items-center.gap-2
                 .form-check.form-switch.mb-0
                   input.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=repository[:auto_review_enabled] disabled=disconnected data-status-target="auto-review-status-#{repository[:id]}" aria-label="Toggle AI review for #{repository[:name]}"

                 span.small.fw-semibold id="auto-review-status-#{repository[:id]}" class=status_class
                      = status_text

              td
                - if repository[:connection_status] == 'Connected'
                  span.badge.badge-soft-success.rounded-pill.px-3.py-2
                    i.bi.bi-link-45deg.me-1
                    | Connected
                - else
                  span.badge.badge-soft-danger.rounded-pill.px-3.py-2
                    i.bi.bi-link-45deg.me-1
                    | Disconnected

              td.text-secondary.small
                = repository[:last_reviewed_at]

              td.text-end
                = link_to repository_path(repository[:id], user_id: params[:user_id]),
                    class: 'btn btn-sm btn-light',
                    aria: { label: "View #{repository[:name]}" } do
                  i.bi.bi-chevron-right

  - else
    .text-center.p-5
      span.empty-state-icon.mb-3
        i.bi.bi-search

      h3.fs-5 No repositories found

      p.text-secondary.mb-4
        | Try changing or clearing your search filters.

      = link_to 'Clear filters',
          repositories_path(user_id: params[:user_id]),
          class: 'btn btn-primary'