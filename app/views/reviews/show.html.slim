.mb-4
  = link_to reviews_path, class: 'text-decoration-none text-secondary small' do
    i.bi.bi-arrow-left.me-2
    | Back to AI reviews

.d-flex.flex-column.flex-xl-row.align-items-xl-start.justify-content-between.gap-4.mb-4
  .d-flex.align-items-start.gap-3
    span.review-detail-icon
      i.bi.bi-code-square

    div
      .d-flex.flex-wrap.align-items-center.gap-2.mb-2
        h1.page-title.mb-0
          | ##{@review[:pull_request_number]} #{@review[:title]}

        - if @review[:status] == 'Completed'
          span.badge.badge-soft-success.rounded-pill.px-3.py-2
            i.bi.bi-check-circle.me-1
            | Completed
        - else
          span.badge.badge-soft-warning.rounded-pill.px-3.py-2
            i.bi.bi-arrow-repeat.me-1
            | Processing

      p.page-description.mb-3
        = @review[:description]

      .d-flex.flex-wrap.align-items-center.gap-3.text-secondary.small
        = link_to repository_path(@review[:repository_id]), class: 'text-decoration-none text-secondary' do
          i.bi.bi-github.me-1
          = @review[:repository_full_name]

        span
          i.bi.bi-git.me-1
          = @review[:source_branch]

        i.bi.bi-arrow-right

        span
          = @review[:target_branch]

        span
          i.bi.bi-person.me-1
          = @review[:author]

  .d-flex.flex-wrap.gap-2
    a.btn.btn-light href=@review[:github_url] target="_blank" rel="noopener"
      i.bi.bi-box-arrow-up-right.me-2
      | View pull request

    button.btn.btn-primary type="button"
      i.bi.bi-arrow-repeat.me-2
      | Run review again

.row.g-4.mb-4
  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-danger.mb-4
        i.bi.bi-bug

      .stat-value.mb-2
        = @review[:issues_found]

      .stat-label Findings

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-file-earmark-code

      .stat-value.mb-2
        = @review[:files_changed]

      .stat-label Files Changed

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-success.mb-4
        i.bi.bi-plus-lg

      .stat-value.mb-2.text-success
        | +#{@review[:additions]}

      .stat-label Additions

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-warning.mb-4
        i.bi.bi-dash-lg

      .stat-value.mb-2.text-danger
        | -#{@review[:deletions]}

      .stat-label Deletions

.row.g-4.align-items-start.mb-4
  .col-12.col-xl-8
    .dashboard-card
      .p-4.border-bottom
        .d-flex.align-items-center.gap-3
          span.ai-summary-icon
            i.bi.bi-stars

          div
            h2.card-title-custom AI review summary

            p.mb-0.mt-1.text-secondary.small
              | Generated by #{@review[:model]}

      .p-4
        p.ai-summary-text.mb-0
          = @review[:summary]

  .col-12.col-xl-4
    .dashboard-card.p-4
      h2.card-title-custom.mb-4 Review information

      .repository-info-row
        span.text-secondary Repository

        = link_to @review[:repository_name],
            repository_path(@review[:repository_id]),
            class: 'fw-semibold text-decoration-none'

      .repository-info-row
        span.text-secondary Pull request

        span.fw-semibold
          | ##{@review[:pull_request_number]}

      .repository-info-row
        span.text-secondary Author

        span.fw-semibold
          = @review[:author]

      .repository-info-row
        span.text-secondary Commit

        code
          = @review[:commit_sha]

      .repository-info-row
        span.text-secondary AI model

        span.ai-model-badge
          i.bi.bi-stars
          = @review[:model]

      .repository-info-row
        span.text-secondary Duration

        span.fw-semibold
          = @review[:duration]

      .repository-info-row
        span.text-secondary Reviewed

        span.fw-semibold
          = @review[:reviewed_at]

      .repository-info-row.border-0.pb-0
        span.text-secondary Conclusion

        span.fw-semibold
          = @review[:conclusion]

.dashboard-card.review-detail-tabs.mb-4
  .review-tab-navigation
    button.review-tab-link.active[
      type="button"
      data-review-tab="findings"
      aria-selected="true"
    ]
      i.bi.bi-bug
      | Findings

      span.review-tab-count
        = @review[:findings].size

    button.review-tab-link[
      type="button"
      data-review-tab="changed-files"
      aria-selected="false"
    ]
      i.bi.bi-file-earmark-code
      | Changed files

      span.review-tab-count
        = @review[:changed_files].size

  .review-tab-content
    .review-tab-panel data-review-panel="findings"
      = render 'reviews/tabs/findings'

    .review-tab-panel.d-none data-review-panel="changed-files"
      = render 'reviews/tabs/changed_files'
