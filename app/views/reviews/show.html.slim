- pull_request = @review.pull_request
- repository = pull_request.repository

.mb-4
  - if params[:pull_request_id].present?
    - back_path = pull_request_path(params[:pull_request_id], repository_id: params[:repository_id])
    - back_text = 'Back to pull request'
  - elsif params[:repository_id].present?
    - back_path = repository_path(params[:repository_id])
    - back_text = 'Back to repository'
  - else
    - back_path = reviews_path
    - back_text = 'Back to AI reviews'

  = link_to back_path, class: 'text-decoration-none text-secondary small' do
    i.bi.bi-arrow-left.me-2
    = back_text

.d-flex.flex-column.flex-xl-row.align-items-xl-start.justify-content-between.gap-4.mb-4
  .d-flex.align-items-start.gap-3
    span.review-detail-icon
      i.bi.bi-code-square

    div
      .d-flex.flex-wrap.align-items-center.gap-2.mb-2
        h1.page-title.mb-0
          | ##{pull_request.number} #{pull_request.title}

        - if @review.status == 'completed'
          span.badge.badge-soft-success.rounded-pill.px-3.py-2
            i.bi.bi-check-circle.me-1
            | Completed
        - elsif @review.status == 'failed'
          span.badge.badge-soft-danger.rounded-pill.px-3.py-2
            i.bi.bi-x-circle.me-1
            | Failed
        - else
          span.badge.badge-soft-warning.rounded-pill.px-3.py-2
            i.bi.bi-arrow-repeat.me-1
            | Processing

      .d-flex.flex-wrap.align-items-center.gap-3.text-secondary.small
        = link_to repository_path(repository), class: 'text-decoration-none text-secondary' do
          i.bi.bi-github.me-1
          = repository.full_name

        span
          i.bi.bi-git.me-1
          = pull_request.source_branch

        i.bi.bi-arrow-right

        span
          = pull_request.target_branch

        span
          i.bi.bi-person.me-1
          = pull_request.author.presence || 'Unknown'

  .d-flex.gap-2
    - if @review.status == 'failed'
      = button_to review_retry_path(@review), method: :post, class: 'btn btn-primary' do
        i.bi.bi-arrow-clockwise.me-2
        | Retry review

    a.btn.btn-light href=pull_request.github_url target="_blank" rel="noopener"
      i.bi.bi-box-arrow-up-right.me-2
      | View pull request

.row.g-4.mb-4
  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-danger.mb-4
        i.bi.bi-bug

      .stat-value.mb-2
        = @review.issues_found_count

      .stat-label Findings

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-file-earmark-code

      .stat-value.mb-2
        = @changed_files.count

      .stat-label Files Changed

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-success.mb-4
        i.bi.bi-plus-lg

      .stat-value.mb-2.text-success
        | +#{@changed_files.sum { |file| file[:additions].to_i }}

      .stat-label Additions

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-warning.mb-4
        i.bi.bi-dash-lg

      .stat-value.mb-2.text-danger
        | -#{@changed_files.sum { |file| file[:deletions].to_i }}

      .stat-label Deletions

.row.g-4.align-items-start.mb-4
  .col-12.col-xl-8
    .dashboard-card
      .p-4.border-bottom
        .d-flex.align-items-center.gap-3
          span.ai-summary-icon
            i.bi.bi-stars

          div
            h2.card-title-custom AI review summary

            p.mb-0.mt-1.text-secondary.small
              | Generated by #{@review.ai_model.name}

      .p-4
        .ai-summary-text
          = markdown(@review.summary.presence || 'No summary available.')

  .col-12.col-xl-4
    .dashboard-card.p-4
      h2.card-title-custom.mb-4 Review information

      .repository-info-row
        span.text-secondary Repository
        = link_to repository.name, repository_path(repository), class: 'fw-semibold text-decoration-none'

      .repository-info-row
        span.text-secondary Pull request
        span.fw-semibold
          | ##{pull_request.number}

      .repository-info-row
        span.text-secondary Author
        span.fw-semibold
          = pull_request.author.presence || 'Unknown'

      .repository-info-row
        span.text-secondary Commit
        code
          = @review.commit_sha.first(8)

      .repository-info-row
        span.text-secondary AI model
        span.ai-model-badge
          i.bi.bi-stars
          = @review.ai_model.name

      .repository-info-row
        span.text-secondary Duration
        span.fw-semibold
          - if @review.latency_ms.present?
            = "#{@review.latency_ms} ms"
          - else
            | -

      .repository-info-row
        span.text-secondary Reviewed
        span.fw-semibold
          - if @review.reviewed_at.present?
            = l(@review.reviewed_at, format: :long)
          - else
            | -

.dashboard-card.review-detail-tabs.mb-4
  .review-tab-navigation
    button.review-tab-link.active type="button" data-review-tab="findings" aria-selected="true"
      i.bi.bi-bug
      | Review

    button.review-tab-link type="button" data-review-tab="changed-files" aria-selected="false"
      i.bi.bi-file-earmark-code
      | Changed files

      span.review-tab-count
        = @changed_files.count

  .review-tab-content
    .review-tab-panel data-review-panel="findings"
      = render 'reviews/tabs/findings'

    .review-tab-panel.d-none data-review-panel="changed-files"
      = render 'reviews/tabs/changed_files'
