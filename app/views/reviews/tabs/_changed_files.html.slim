.p-4.border-bottom
  h2.card-title-custom Changed files

  p.mb-0.mt-1.text-secondary.small
    | Files analyzed by AI for this review.

- if @changed_files.any?
  .list-group.list-group-flush
    - @changed_files.each do |file|
      .list-group-item.p-4
        .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3
          .d-flex.align-items-center.gap-3
            span.changed-file-icon
              i.bi.bi-file-earmark-code

            div
              p.mb-1.fw-semibold
                = file[:filename]

              p.mb-0.text-secondary.small
                = file[:status].to_s.capitalize

          .d-flex.align-items-center.gap-3.small
            span.text-success
              | +#{file[:additions]}

            span.text-danger
              | -#{file[:deletions]}
- else
  .p-5.text-center.text-secondary
    i.bi.bi-file-earmark.fs-3.d-block.mb-2
    | No changed files found for this review.
