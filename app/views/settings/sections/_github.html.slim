section.dashboard-card.settings-section
  .settings-section-header
    .d-flex.align-items-center.gap-3
      span.settings-section-icon.settings-section-icon-dark
        i.bi.bi-github

      div
        h2.card-title-custom GitHub integration

        p.mb-0.mt-1.text-secondary.small
          | Manage the GitHub account connected to AI Code Review.

  .settings-section-body
    .integration-card
      .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-4
        .d-flex.align-items-center.gap-3
          span.integration-logo
            i.bi.bi-github

          div
            .d-flex.flex-wrap.align-items-center.gap-2.mb-1
              h3.integration-title.mb-0
                | @#{@settings[:github][:account]}

              span.badge.badge-soft-success.rounded-pill.px-3.py-2
                i.bi.bi-check-circle.me-1
                = @settings[:github][:installation_status]

            p.mb-1.text-secondary.small
              | #{@settings[:github][:repositories_count]} repositories connected

            p.mb-0.text-secondary.small
              | Connected on #{@settings[:github][:connected_at]}

        .d-flex.flex-wrap.gap-2
          button.btn.btn-light type="button"
            i.bi.bi-arrow-repeat.me-2
            | Reconnect

          button.btn.btn-outline-danger type="button"
            i.bi.bi-link-45deg.me-2
            | Disconnect
