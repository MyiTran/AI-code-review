section.dashboard-card.settings-section
  .settings-section-header
    .d-flex.align-items-center.gap-3
      span.settings-section-icon.settings-section-icon-warning
        i.bi.bi-bell

      div
        h2.card-title-custom Notifications

        p.mb-0.mt-1.text-secondary.small
          | Choose when and where you receive review updates.

  .settings-section-body
    .settings-option
      .settings-option-copy
        label.settings-option-title for="notify-completed"
          | Completed reviews

        p.settings-option-description
          | Send an email when an AI review is completed.

      .form-check.form-switch.mb-0
        input#notify-completed.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:email_completed_reviews]

    .settings-option
      .settings-option-copy
        label.settings-option-title for="notify-failed"
          | Failed reviews

        p.settings-option-description
          | Notify you when a review fails and requires attention.

      .form-check.form-switch.mb-0
        input#notify-failed.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:email_failed_reviews]

    .settings-option
      .settings-option-copy
        label.settings-option-title for="notify-weekly"
          | Weekly summary

        p.settings-option-description
          | Receive a weekly summary of repositories, reviews and findings.

      .form-check.form-switch.mb-0
        input#notify-weekly.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:email_weekly_summary]

    .settings-option
      .settings-option-copy
        label.settings-option-title for="github-comments"
          | Post review results on GitHub

        p.settings-option-description
          | Add AI findings as a comment on the associated pull request.

      .form-check.form-switch.mb-0
        input#github-comments.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:github_comments]

    .settings-actions
      button.btn.btn-primary.settings-save-button type="button"
        i.bi.bi-check-lg.me-2
        | Save notifications
