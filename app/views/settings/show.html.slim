.d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Settings

    p.page-description
      | Manage your profile, AI review preferences and integrations.

.row.g-4.align-items-start
  .col-12.col-xl-3
    .dashboard-card.settings-navigation-card
      nav.settings-navigation
        = link_to settings_path(tab: "profile"),
            class: "settings-navigation-item #{'active' if @active_tab == 'profile'}" do
          span.settings-navigation-icon
            i.bi.bi-person

          span
            strong Profile
            small Personal information

        = link_to settings_path(tab: "ai_review"),
            class: "settings-navigation-item #{'active' if @active_tab == 'ai_review'}" do
          span.settings-navigation-icon
            i.bi.bi-stars

          span
            strong AI review
            small Review configuration

        = link_to settings_path(tab: "notifications"),
            class: "settings-navigation-item #{'active' if @active_tab == 'notifications'}" do
          span.settings-navigation-icon
            i.bi.bi-bell

          span
            strong Notifications
            small Email and GitHub alerts

        = link_to settings_path(tab: "github"),
            class: "settings-navigation-item #{'active' if @active_tab == 'github'}" do
          span.settings-navigation-icon
            i.bi.bi-github

          span
            strong GitHub integration
            small Connected account

        = link_to settings_path(tab: "billing"),
            class: "settings-navigation-item #{'active' if @active_tab == 'billing'}" do
          span.settings-navigation-icon
            i.bi.bi-credit-card

          span
            strong Plan and usage
            small Current subscription

  .col-12.col-xl-9
    - case @active_tab
    - when "ai_review"
      = render "settings/sections/ai_review"
    - when "notifications"
      = render "settings/sections/notifications"
    - when "github"
      = render "settings/sections/github"
    - when "billing"
      = render "settings/sections/billing"
    - else
      = render "settings/sections/profile"
