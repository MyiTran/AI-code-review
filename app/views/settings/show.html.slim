.d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Settings
    p.page-description
      | Manage your account information.

.dashboard-card.mb-4
  .p-4.border-bottom
    .d-flex.align-items-center.gap-3
      span.settings-section-icon
        i.bi.bi-person

      div
        h2.card-title-custom Account
        p.mb-0.mt-1.text-secondary.small
          | Your account information from GitHub.

  .p-4
    .d-flex.flex-column.flex-md-row.align-items-md-center.gap-4.mb-4
      - if current_user.avatar_url.present?
        = image_tag current_user.avatar_url, class: 'rounded-circle', width: 72, height: 72, alt: current_user.display_name
      - else
        .rounded-circle.bg-light.d-flex.align-items-center.justify-content-center style="width: 72px; height: 72px;"
          span.fw-bold.fs-4
            = current_user.initials

      div
        h3.fs-5.mb-1
          = current_user.display_name.presence || 'GitHub user'

        - if current_user.github_username.present?
          p.text-secondary.mb-0
            | @#{current_user.github_username}

    .row.g-4
      .col-12.col-md-6
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Name
          span.fw-semibold
            = current_user.full_name.presence || 'Not provided'

      .col-12.col-md-6
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Email
          span.fw-semibold
            = current_user.email

      .col-12.col-md-6
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 GitHub username
          span.fw-semibold
            = current_user.github_username.presence || 'Not available'

      .col-12.col-md-6
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Connected account
          span.badge.badge-soft-success.rounded-pill.px-3.py-2
            i.bi.bi-github.me-1
            | GitHub

.dashboard-card
  .p-4.border-bottom
    .d-flex.align-items-center.gap-3
      span.settings-section-icon
        i.bi.bi-shield-check

      div
        h2.card-title-custom Sign-in information
        p.mb-0.mt-1.text-secondary.small
          | Information about your account activity.

  .p-4
    .row.g-4
      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Member since
          span.fw-semibold
            = l(current_user.created_at, format: :long)

      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Last signed in
          span.fw-semibold
            - if current_user.last_sign_in_at.present?
              = l(current_user.last_sign_in_at, format: :long)
            - else
              | Not available

      .col-12.col-md-4
        .settings-info-item
          span.text-secondary.small.d-block.mb-1 Sign-in count
          span.fw-semibold
            = current_user.sign_in_count
            