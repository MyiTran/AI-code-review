header.app-navbar.d-flex.align-items-center
  .container-fluid.px-4
    .d-flex.align-items-center.justify-content-between.w-100
      .d-flex.align-items-center.gap-3
        button.btn.btn-light.mobile-menu-button type="button"
          i.bi.bi-list

        div
          p.mb-0.fw-semibold
            | AI Code Review

          p.mb-0.text-secondary.small
            = controller_path.start_with?('admin/') ? 'Administration' : 'Automated code review powered by AI'

      - unless controller_path.start_with?('admin/')
        button.btn.btn-light.position-relative.rounded-circle.p-0[
          type="button"
          aria-label="Notifications"
          style="width: 40px; height: 40px;"
        ]
          i.bi.bi-bell

          span.position-absolute.top-0.start-100.translate-middle.p-1.bg-danger.border.border-light.rounded-circle
