default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  <% if ENV["DB_HOST"] %>
  host: <%= ENV["DB_HOST"] %>
  username: postgres
  password: postgres
  <% end %>


development:
  <<: *default
  database: rails_boilerplate_development

test:
  <<: *default
  database: rails_boilerplate_test

production:
  <<: *default
  url: <%= ENV.fetch('DATABASE_URL') %>
